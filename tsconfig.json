{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@harmony/core": ["packages/core/src/index.ts"],
      "@harmony/content": ["packages/content/src/index.ts"],
      "@harmony/ai": ["packages/ai/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/web/src", "apps/web/e2e", "evals", "apps/web/vite.config.ts", "apps/web/playwright.config.ts", "vitest.config.ts"]
}
